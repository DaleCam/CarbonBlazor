@page "/Layout"
<h3>Layout</h3>
<section>
    <CbBreadcrumb>
        <CbBreadcrumbItem Href="/">Home</CbBreadcrumbItem>
        <CbBreadcrumbItem Current="true">Layout</CbBreadcrumbItem>
    </CbBreadcrumb>
</section>
<section id="shell" class="docs-section">
    <h2>UI shell</h2>
    <p>
        <code>CbHeaderNavMenu</code> adds a dropdown submenu to the header nav, <code>CbSideNavMenu</code>/<code>CbSideNavMenuItem</code>
        add a collapsible group to the side nav, and <code>CbSideNavDivider</code>/<code>CbSkipToContent</code> round
        out parity with
        Carbon's UI Shell.
    </p>
    <div style="position:relative;border:1px solid var(--cb-border-subtle);overflow:hidden;">
        <CbSkipToContent Href="#shell-demo-content"/>
        <CbHeader ProductName="Cloud" Prefix="IBM" SideNavOpen="_shellSideNavOpen"
                  SideNavOpenChanged="@(value => _shellSideNavOpen = value)">
            <NavContent>
                <CbHeaderNavLink Href="#">Catalog</CbHeaderNavLink>
                <CbHeaderNavLink Href="#">Docs</CbHeaderNavLink>
                <CbHeaderNavLink Href="#">Support</CbHeaderNavLink>
                <CbHeaderNavMenu Text="Manage">
                    <CbHeaderMenuItem Href="#">Account</CbHeaderMenuItem>
                    <CbHeaderMenuItem Href="#">Access (IAM)</CbHeaderMenuItem>
                    <CbHeaderMenuItem Href="#">Billing and usage</CbHeaderMenuItem>
                </CbHeaderNavMenu>
                <CbHeaderNavLink Href="#">Status</CbHeaderNavLink>
            </NavContent>
            <Search>
                <CbHeaderSearch @bind-Value="_shellSearch" @bind-Active="_shellSearchActive"
                                Placeholder="Search resources">
                    @foreach (var result in FilteredResults)
                    {
                        <CbHeaderSearchResult Text="@result.Name" Description="@result.Kind"
                                              OnSelect="@(() => _shellSelected = result.Name)" />
                    }
                </CbHeaderSearch>
            </Search>
        </CbHeader>
        <div style="position:relative;height:20rem;overflow:hidden;">
            <CbSideNav Open="_shellSideNavOpen" OpenChanged="@(value => _shellSideNavOpen = value)" ShowOverlay="true"
                       style="position:absolute;top:0;">
                <CbSideNavLink Href="#" aria-current="page">Dashboard</CbSideNavLink>
                <CbSideNavLink Href="#">Resource list</CbSideNavLink>
                <CbSideNavLink Href="#">Activity tracker</CbSideNavLink>
                <CbSideNavMenu Text="Kubernetes" @bind-Open="_shellKubernetesOpen">
                    <CbSideNavMenuItem Href="#">Clusters</CbSideNavMenuItem>
                    <CbSideNavMenuItem Href="#">Worker pools</CbSideNavMenuItem>
                    <CbSideNavMenuItem Href="#">Container registry</CbSideNavMenuItem>
                </CbSideNavMenu>
                <CbSideNavDivider/>
                <CbSideNavLink Href="#">Account settings</CbSideNavLink>
            </CbSideNav>
            <div id="shell-demo-content"
                 style="@(_shellSideNavOpen ? "padding:1rem;margin-left:16rem;" : "padding:1rem;")">
                <h1>Dashboard</h1>
                <p>Last selected search result: <strong>@(_shellSelected ?? "none")</strong></p>
            </div>
        </div>
    </div>
    <h3>Header search with custom results</h3>
    <p>
        Slot a <code>CbHeaderSearch</code> into the header's <code>Search</code> fragment and render
        <code>CbHeaderSearchResult</code> items (or fully custom markup via child content) for the current query.
        The field expands over the header, closes on <kbd>Esc</kbd> or an outside click, and supports
        <code>@@bind-Value</code>/<code>@@bind-Active</code>.
    </p>
    <CbCodeSnippet>&lt;CbHeader ProductName="Cloud" Prefix="IBM"&gt;
    &lt;Search&gt;
        &lt;CbHeaderSearch @@bind-Value="_query" @@bind-Active="_active" Placeholder="Search resources"&gt;
            @@foreach (var result in Filtered)
            {
                &lt;CbHeaderSearchResult Text="@@result.Name" Description="@@result.Kind"
                                      OnSelect="@@(() =&gt; Select(result))" /&gt;
            }
        &lt;/CbHeaderSearch&gt;
    &lt;/Search&gt;
&lt;/CbHeader&gt;</CbCodeSnippet>
</section>

@code {
    private bool _shellSideNavOpen = true;
    private bool _shellKubernetesOpen = true;
    private string? _shellSearch;
    private bool _shellSearchActive;
    private string? _shellSelected;

    private record Resource(string Name, string Kind);

    private static readonly Resource[] AllResources =
    {
        new("web-prod-01", "Virtual server"),
        new("web-prod-02", "Virtual server"),
        new("billing-db", "Databases for PostgreSQL"),
        new("assets-cos", "Cloud Object Storage"),
        new("edge-lb", "Load Balancer"),
        new("cluster-eu", "Kubernetes cluster"),
    };

    private IEnumerable<Resource> FilteredResults =>
        string.IsNullOrWhiteSpace(_shellSearch)
            ? AllResources
            : AllResources.Where(r => r.Name.Contains(_shellSearch, StringComparison.OrdinalIgnoreCase)
                                      || r.Kind.Contains(_shellSearch, StringComparison.OrdinalIgnoreCase));
}