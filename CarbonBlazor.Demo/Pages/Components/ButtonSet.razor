@page "/components/button-set"
@using CarbonBlazor

<PageTitle>ButtonSet Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">ButtonSet</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>ButtonSet</h1>
<p class="docs-lede">ButtonSet groups related buttons for consistent spacing and alignment.</p>

<section class="docs-section">
    <h2>Example</h2>
    <CbButtonSet>
        <CbButton>Primary</CbButton>
        <CbButton Variant="CbButtonVariant.Secondary">Secondary</CbButton>
        <CbButton Variant="CbButtonVariant.Tertiary">Tertiary</CbButton>
    </CbButtonSet>
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>ChildContent</code></td>
                <td><code>RenderFragment?</code></td>
                <td><code>null</code></td>
                <td>Button components to display in the set.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

