@code {
    private bool _checked1 = false;
    private bool _checked2 = true;
    private bool _item1 = false;
    private bool _item2 = false;
    private bool _item3 = false;

    private bool _allSelected => _item1 && _item2 && _item3;
    private bool _selectAllIndeterminate => !_allSelected && (_item1 || _item2 || _item3);

    private void OnSelectAllChanged(bool value)
    {
        _item1 = _item2 = _item3 = value;
    }
}
