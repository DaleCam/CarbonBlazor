@page "/components/checkbox"
@using CarbonBlazor

<PageTitle>Checkbox Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Checkbox</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Checkbox</h1>
<p class="docs-lede">Checkbox allows users to select one or more options from a set.</p>

<section class="docs-section">
    <h2>Examples</h2>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <CbCheckbox @bind-Value="_checked1">Option one</CbCheckbox>
        <CbCheckbox @bind-Value="_checked2">Option two (checked by default)</CbCheckbox>
        <CbCheckbox Disabled="true">Disabled option</CbCheckbox>
        <CbCheckbox Invalid="true">Invalid option</CbCheckbox>
    </div>
    <CbCodeSnippet>&lt;CbCheckbox @@bind-Value="_checked1"&gt;Option one&lt;/CbCheckbox&gt;
&lt;CbCheckbox @@bind-Value="_checked2"&gt;Option two (checked by default)&lt;/CbCheckbox&gt;
&lt;CbCheckbox Disabled="true"&gt;Disabled option&lt;/CbCheckbox&gt;
&lt;CbCheckbox Invalid="true"&gt;Invalid option&lt;/CbCheckbox&gt;</CbCodeSnippet>
</section>

<section class="docs-section">
    <h2>Indeterminate State</h2>
    <p>Indeterminate checkboxes are useful for showing partial selection in a group. "Select All" shows a dash while some, but not all, items are checked.</p>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
            <CbCheckbox Value="_allSelected" Indeterminate="_selectAllIndeterminate" ValueChanged="OnSelectAllChanged">Select All</CbCheckbox>
        </div>
        <div style="margin-left: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <CbCheckbox @bind-Value="_item1">Item 1</CbCheckbox>
            <CbCheckbox @bind-Value="_item2">Item 2</CbCheckbox>
            <CbCheckbox @bind-Value="_item3">Item 3</CbCheckbox>
        </div>
    </div>
    <CbCodeSnippet>&lt;CbCheckbox Value="_allSelected" Indeterminate="_selectAllIndeterminate" ValueChanged="OnSelectAllChanged"&gt;
    Select All
&lt;/CbCheckbox&gt;

&lt;CbCheckbox @@bind-Value="_item1"&gt;Item 1&lt;/CbCheckbox&gt;
&lt;CbCheckbox @@bind-Value="_item2"&gt;Item 2&lt;/CbCheckbox&gt;
&lt;CbCheckbox @@bind-Value="_item3"&gt;Item 3&lt;/CbCheckbox&gt;

@@code {
    private bool _item1, _item2, _item3;

    private bool _allSelected => _item1 && _item2 && _item3;
    private bool _selectAllIndeterminate => !_allSelected &amp;&amp; (_item1 || _item2 || _item3);

    private void OnSelectAllChanged(bool value)
    {
        _item1 = _item2 = _item3 = value;
    }
}</CbCodeSnippet>
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Value</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Checked state of the checkbox. Use with @@bind-Value for two-way binding.</td>
            </tr>
            <tr>
                <td><code>ValueChanged</code></td>
                <td><code>EventCallback&lt;bool&gt;</code></td>
                <td>-</td>
                <td>Event callback fired when checkbox state changes.</td>
            </tr>
            <tr>
                <td><code>Indeterminate</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Shows a dash instead of a checkmark, used for partial selection in a group.</td>
            </tr>
            <tr>
                <td><code>Disabled</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Disables the checkbox and prevents user interaction.</td>
            </tr>
            <tr>
                <td><code>Invalid</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Marks checkbox as invalid.</td>
            </tr>
            <tr>
                <td><code>Id</code></td>
                <td><code>string?</code></td>
                <td>auto-generated</td>
                <td>HTML id attribute. Auto-generated if not provided.</td>
            </tr>
            <tr>
                <td><code>ChildContent</code></td>
                <td><code>RenderFragment?</code></td>
                <td><code>null</code></td>
                <td>Label text or content for the checkbox.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

