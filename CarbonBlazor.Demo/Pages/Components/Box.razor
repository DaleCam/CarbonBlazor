@page "/components/box"
@using CarbonBlazor
@using CarbonBlazor.Components.Layout

<PageTitle>Box Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Box</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Box</h1>
<p class="docs-lede">Box is a layout utility component for applying spacing and background tokens to containers.</p>

<section class="docs-section">
    <h2>Basic</h2>
    <CbBox Fill="layer" Padding="5" Border="strong">
        <p>Box with layer background, padding 5, and strong border</p>
    </CbBox>
</section>

<section class="docs-section">
    <h2>Fill Tokens</h2>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <CbBox Fill="background" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">background</span>
        </CbBox>
        <CbBox Fill="layer" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">layer</span>
        </CbBox>
        <CbBox Fill="layer-accent" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">layer-accent</span>
        </CbBox>
        <CbBox Fill="inverse" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600; color: white;">inverse</span>
        </CbBox>
    </div>
</section>

<section class="docs-section">
    <h2>Border Tokens</h2>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <CbBox Border="subtle" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">subtle</span>
        </CbBox>
        <CbBox Border="strong" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">strong</span>
        </CbBox>
        <CbBox Border="interactive" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">interactive</span>
        </CbBox>
        <CbBox Border="disabled" Padding="5" Width="120px">
            <span style="font-size: 0.75rem; font-weight: 600;">disabled</span>
        </CbBox>
    </div>
</section>

<section class="docs-section">
    <h2>Padding Scale</h2>
    <div style="display: flex; gap: 1rem; flex-direction: column;">
        <div>
            <h4>Padding 2</h4>
            <CbBox Fill="layer" Padding="2">Content with p=2 (0.25rem)</CbBox>
        </div>
        <div>
            <h4>Padding 4</h4>
            <CbBox Fill="layer" Padding="4">Content with p=4 (0.75rem)</CbBox>
        </div>
        <div>
            <h4>Padding 6</h4>
            <CbBox Fill="layer" Padding="6">Content with p=6 (1.5rem)</CbBox>
        </div>
        <div>
            <h4>Padding 8</h4>
            <CbBox Fill="layer" Padding="8">Content with p=8 (2.5rem)</CbBox>
        </div>
    </div>
</section>

<section class="docs-section">
    <h2>Directional Padding</h2>
    <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
        <div>
            <h4>Horizontal (px=4)</h4>
            <CbBox Fill="layer" PaddingX="4" PaddingY="3">
                Content with px=4, py=3
            </CbBox>
        </div>
        <div>
            <h4>Vertical (py=6)</h4>
            <CbBox Fill="layer" PaddingX="3" PaddingY="6">
                Content with px=3, py=6
            </CbBox>
        </div>
    </div>
</section>

<section class="docs-section">
    <h2>Margin</h2>
    <div style="display: flex; gap: 1rem; flex-direction: column;">
        <div>
            <h4>Margin 3</h4>
            <CbBox Fill="layer-accent" Padding="3" Margin="3">Box with margin 3</CbBox>
        </div>
        <div>
            <h4>Horizontal Margin (mx=5)</h4>
            <CbBox Fill="layer-accent" Padding="3" MarginX="5">Box with mx=5</CbBox>
        </div>
    </div>
</section>

