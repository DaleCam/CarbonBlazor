@page "/components/toggle"
@using CarbonBlazor

<PageTitle>Toggle Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Toggle</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Toggle</h1>
<p class="docs-lede">Toggle switch for binary on/off choices with accessible keyboard interaction.</p>

<section class="docs-section">
    <h2>Examples</h2>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <CbToggle Label="Enable notifications" @bind-Value="_toggle1" />
        <CbToggle Label="Dark mode" @bind-Value="_toggle2" />
        <CbToggle Label="Disabled toggle" Disabled="true" />
    </div>
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Value</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Toggled state. Use with @@bind-Value for two-way binding.</td>
            </tr>
            <tr>
                <td><code>ValueChanged</code></td>
                <td><code>EventCallback&lt;bool&gt;</code></td>
                <td>-</td>
                <td>Event fired when toggle state changes.</td>
            </tr>
            <tr>
                <td><code>Label</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Label text displayed next to toggle.</td>
            </tr>
            <tr>
                <td><code>Disabled</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Disables the toggle.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Related</h2>
    <ul>
        <li><a href="/components/checkbox">Checkbox</a></li>
        <li><a href="/components/radio-button">RadioButton</a></li>
    </ul>
</section>

@code {
    private bool _toggle1;
    private bool _toggle2;
}
