@code {
    public record Load(string Name, string Rule, string Status);

    private readonly IReadOnlyList<Load> _loads =
    [
        new("Nightly export", "Retail feed", "Passed"),
        new("Hourly sync", "Inventory", "Running"),
        new("Weekly rollup", "Finance", "Failed"),
    ];

    private IReadOnlyList<Load> _selected = [];

    private int _page = 1;
    private int _pageSize = 5;

    private static readonly string[] _rules = ["Retail feed", "Inventory", "Finance", "Logistics", "Marketing"];
    private static readonly string[] _statuses = ["Passed", "Running", "Failed"];

    private readonly IReadOnlyList<Load> _allLoads =
        Enumerable.Range(1, 23)
            .Select(i => new Load($"Load #{i}", _rules[i % _rules.Length], _statuses[i % _statuses.Length]))
            .ToList();

    private IReadOnlyList<Load> _pageItems =>
        _allLoads.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private readonly IReadOnlyList<CbDataTableColumn<Load>> _columns =
    [
        new() { Header = "Name", Text = l => l.Name, SortKey = l => l.Name },
        new() { Header = "Rule", Text = l => l.Rule, SortKey = l => l.Rule },
        new() { Header = "Status", Text = l => l.Status, SortKey = l => l.Status },
    ];
}
