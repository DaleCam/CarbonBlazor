@page "/components/notification"
@using CarbonBlazor

<PageTitle>Notification Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Notification</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Notification</h1>
<p class="docs-lede">Notification communicates messages to users with contextual status information.</p>

<section class="docs-section">
    <h2>Examples</h2>
    <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 100%;">
        <CbNotification Kind="CbNotificationKind.Success" Title="Success" Subtitle="Operation completed successfully." Closeable="true" />
        <CbNotification Kind="CbNotificationKind.Error" Title="Error" Subtitle="An error occurred while processing your request." Closeable="true" />
        <CbNotification Kind="CbNotificationKind.Warning" Title="Warning" Subtitle="Please review before continuing." Closeable="true" />
        <CbNotification Kind="CbNotificationKind.Info" Title="Info" Subtitle="For your information." Closeable="true" />
    </div>
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Kind</code></td>
                <td><code>CbNotificationKind</code></td>
                <td><code>Info</code></td>
                <td>Notification type: Success, Error, Warning, or Info.</td>
            </tr>
            <tr>
                <td><code>Title</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Notification title.</td>
            </tr>
            <tr>
                <td><code>Subtitle</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Notification subtitle or description.</td>
            </tr>
            <tr>
                <td><code>Closeable</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>Show close button to dismiss notification.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Accessibility</h2>
    <ul>
        <li>Uses ARIA live regions for announcement</li>
        <li>Status messages are conveyed to screen readers</li>
    </ul>
</section>

<section class="docs-section">
    <h2>Related</h2>
    <ul>
        <li><a href="/components/tag">Tag</a></li>
    </ul>
</section>
