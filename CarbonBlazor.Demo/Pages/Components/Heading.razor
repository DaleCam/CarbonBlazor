<section class="docs-section">
    <h2>Props — Section</h2>
    <table class="docs-props-table">
        <thead>
            <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
        </thead>
        <tbody>
            <tr><td><code>Level</code></td><td><code>int?</code></td><td><code>null</code></td><td>Explicit starting level (1–6). Derived from nesting when omitted.</td></tr>
            <tr><td><code>Tag</code></td><td><code>string</code></td><td><code>"section"</code></td><td>Element rendered for the wrapper.</td></tr>
            <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td><code>null</code></td><td>Section content.</td></tr>
            <tr><td><code>Class</code></td><td><code>string?</code></td><td><code>null</code></td><td>Additional CSS classes.</td></tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Accessibility</h2>
    <ul>
        <li>Heading levels never skip and are capped at <code>h6</code>.</li>
        <li>Nesting Sections keeps the outline valid for assistive technology.</li>
    </ul>
</section>

