@page "/components/tabs"
@using CarbonBlazor
@using CarbonBlazor.Components.Layout

<PageTitle>Tabs Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Tabs</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Tabs</h1>
<p class="docs-lede">Tabs organize content into separate views within the same context. Users click tab labels to switch between them.</p>

<section class="docs-section">
    <h2>Basic</h2>
    <CbTabs Items="@_tabItems" />
</section>

<section class="docs-section">
    <h2>Container Type</h2>
    <p>Use the <code>Type="container"</code> prop for a contained tab style.</p>
    <CbBox Fill="layer" Padding="6">
        <CbTabs Type="container" Items="@_tabItems" />
    </CbBox>
</section>

<section class="docs-section">
    <h2>Sizes</h2>
    <div style="display: flex; flex-direction: column; gap: 2rem;">
        <div>
            <h4>Small</h4>
            <CbTabs Size="sm" Items="@_tabItems" />
        </div>
        <div>
            <h4>Medium</h4>
            <CbTabs Size="md" Items="@_tabItems" />
        </div>
        <div>
            <h4>Large</h4>
            <CbTabs Size="lg" Items="@_tabItems" />
        </div>
    </div>
</section>

<section class="docs-section">
    <h2>Icon Only</h2>
    <p>Use the <code>IconOnly</code> prop to display only icons. Set an icon on each tab item.</p>
    <CbTabs IconOnly="true" Items="@_iconOnlyItems" />
</section>

<section class="docs-section">
    <h2>Icons with Labels</h2>
    <p>Display both icon and label on each tab.</p>
    <CbTabs Items="@_iconWithLabelItems" />
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Items</code></td>
                <td><code>IReadOnlyList&lt;CbTabItem&gt;</code></td>
                <td>-</td>
                <td>Collection of tab items containing label and content.</td>
            </tr>
            <tr>
                <td><code>SelectedIndex</code></td>
                <td><code>int</code></td>
                <td><code>0</code></td>
                <td>Index of the currently selected tab (zero-based).</td>
            </tr>
            <tr>
                <td><code>SelectedIndexChanged</code></td>
                <td><code>EventCallback&lt;int&gt;</code></td>
                <td>-</td>
                <td>Event callback fired when selected tab changes.</td>
            </tr>
            <tr>
                <td><code>IconOnly</code></td>
                <td><code>bool</code></td>
                <td><code>false</code></td>
                <td>When true, renders only the icon for each tab, hiding labels. Labels appear as tooltips.</td>
            </tr>
            <tr>
                <td><code>Type</code></td>
                <td><code>string</code></td>
                <td><code>"line"</code></td>
                <td>Tab style: <code>"line"</code> (default) or <code>"container"</code>.</td>
            </tr>
            <tr>
                <td><code>Size</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Tab size: <code>"sm"</code>, <code>"md"</code>, <code>"lg"</code>, or <code>"xl"</code> (container only). Null uses default size.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply to the tab container.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>CbTabItem Properties</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Property</th>
                <th>Type</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Label</code></td>
                <td><code>string</code></td>
                <td>The text displayed on the tab label.</td>
            </tr>
            <tr>
                <td><code>Content</code></td>
                <td><code>RenderFragment</code></td>
                <td>The content rendered when this tab is selected.</td>
            </tr>
            <tr>
                <td><code>Icon</code></td>
                <td><code>RenderFragment?</code></td>
                <td>Optional icon to display alongside or instead of the label.</td>
            </tr>
            <tr>
                <td><code>Disabled</code></td>
                <td><code>bool</code></td>
                <td>Whether the tab is disabled and cannot be selected.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Keyboard Navigation</h2>
    <ul>
        <li><strong>Left/Right arrows:</strong> Move focus to previous/next tab</li>
        <li><strong>Home:</strong> Jump to first tab</li>
        <li><strong>End:</strong> Jump to last tab</li>
        <li><strong>Enter/Space:</strong> Activate selected tab</li>
    </ul>
</section>

<section class="docs-section">
    <h2>Related</h2>
    <ul>
        <li><a href="/components/accordion">Accordion</a></li>
    </ul>
</section>

@code {
    private IReadOnlyList<CbTabItem> _tabItems { get; } =
    [
        new() { Label = "Documentation", Content = builder => builder.AddContent(0, "Tab content for documentation with examples and usage patterns.") },
        new() { Label = "Code", Content = builder => builder.AddContent(0, "Code example showing how to use the Tabs component with Blazor.") },
        new() { Label = "Accessibility", Content = builder => builder.AddContent(0, "Accessibility information including keyboard navigation and ARIA attributes.") }
    ];

    private IReadOnlyList<CbTabItem> _iconOnlyItems { get; } =
    [
        new()
        {
            Label = "Activity",
            Icon = @<CbIcon Name="CbIconName.Activity" />,
            Content = builder => builder.AddContent(0, "Activity tab content.")
        },
        new()
        {
            Label = "Calendar",
            Icon = @<CbIcon Name="CbIconName.Calendar" />,
            Content = builder => builder.AddContent(0, "Calendar tab content.")
        },
        new()
        {
            Label = "Dashboard",
            Icon = @<CbIcon Name="CbIconName.Dashboard" />,
            Content = builder => builder.AddContent(0, "Dashboard tab content.")
        }
    ];

    private IReadOnlyList<CbTabItem> _iconWithLabelItems { get; } =
    [
        new()
        {
            Label = "Activity",
            Icon = @<CbIcon Name="CbIconName.Activity" />,
            Content = builder => builder.AddContent(0, "Activity tab content.")
        },
        new()
        {
            Label = "Calendar",
            Icon = @<CbIcon Name="CbIconName.Calendar" />,
            Content = builder => builder.AddContent(0, "Calendar tab content.")
        },
        new()
        {
            Label = "Dashboard",
            Icon = @<CbIcon Name="CbIconName.Dashboard" />,
            Content = builder => builder.AddContent(0, "Dashboard tab content.")
        }
    ];
}
