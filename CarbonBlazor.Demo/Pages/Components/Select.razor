@page "/components/select"
@using CarbonBlazor

<PageTitle>Select Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Select</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Select</h1>
<p class="docs-lede">Native HTML select element styled with Carbon Design System.</p>

<section class="docs-section">
    <h2>Example</h2>
    <CbSelect Label="Choose country">
        <option value="">Select...</option>
        <option value="usa">United States</option>
        <option value="canada">Canada</option>
        <option value="mexico">Mexico</option>
    </CbSelect>
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Label</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Label text displayed above select.</td>
            </tr>
            <tr>
                <td><code>ChildContent</code></td>
                <td><code>RenderFragment?</code></td>
                <td><code>null</code></td>
                <td>Option elements for the select.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Related</h2>
    <ul>
        <li><a href="/components/dropdown">Dropdown</a></li>
    </ul>
</section>
