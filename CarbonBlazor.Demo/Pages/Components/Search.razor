@page "/components/search"
@using CarbonBlazor

<PageTitle>Search Component</PageTitle>

<CbBreadcrumb>
    <CbBreadcrumbItem Href="/">Overview</CbBreadcrumbItem>
    <CbBreadcrumbItem Href="/components">Components</CbBreadcrumbItem>
    <CbBreadcrumbItem Current="true">Search</CbBreadcrumbItem>
</CbBreadcrumb>

<h1>Search</h1>
<p class="docs-lede">Search input field with built-in search icon for finding and filtering content.</p>

<section class="docs-section">
    <h2>Example</h2>
    <CbSearch Placeholder="Search..." @bind-Value="_searchValue" />
</section>

<section class="docs-section">
    <h2>Props</h2>
    <table class="docs-props-table">
        <thead>
            <tr>
                <th>Prop</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>Value</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Search input value. Use with @@bind-Value for two-way binding.</td>
            </tr>
            <tr>
                <td><code>ValueChanged</code></td>
                <td><code>EventCallback&lt;string?&gt;</code></td>
                <td>-</td>
                <td>Event fired when search value changes.</td>
            </tr>
            <tr>
                <td><code>Placeholder</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Placeholder text shown in empty search field.</td>
            </tr>
            <tr>
                <td><code>Class</code></td>
                <td><code>string?</code></td>
                <td><code>null</code></td>
                <td>Additional CSS classes to apply.</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="docs-section">
    <h2>Related</h2>
    <ul>
        <li><a href="/components/text-input">TextInput</a></li>
    </ul>
</section>

@code {
    private string? _searchValue;
}
