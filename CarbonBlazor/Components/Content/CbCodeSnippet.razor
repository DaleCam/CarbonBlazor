@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@ClassName" @attributes="AdditionalAttributes">
    <code id="@_codeId" class="cb-code-snippet__code">@Code@ChildContent</code>
    @if (ShowCopyButton)
    {
        <button type="button"
                class="cb-code-snippet__copy"
                aria-label="@CopyButtonLabel"
                @onclick="CopyAsync">
            <span aria-hidden="true">@(_copied ? "✓" : "⧉")</span>
            <span class="cb-code-snippet__feedback" role="status" aria-live="polite">
                @(_copied ? CopiedLabel : null)
            </span>
        </button>
    }
</div>

@code {
    private readonly string _codeId = $"cb-code-snippet-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _copied;
    private CancellationTokenSource? _resetCts;

    [Parameter] public string? Code { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowCopyButton { get; set; } = true;
    [Parameter] public string CopyButtonLabel { get; set; } = "Copy to clipboard";
    [Parameter] public string CopiedLabel { get; set; } = "Copied!";
    [Parameter] public EventCallback OnCopy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassName => new CssBuilder("cb-code-snippet").Add(Class).ToString();

    private async Task CopyAsync()
    {
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/CarbonBlazor/carbon-blazor.js");
        var ok = await _module.InvokeAsync<bool>("copyElementText", _codeId);
        if (!ok)
        {
            return;
        }

        await OnCopy.InvokeAsync();

        _resetCts?.Cancel();
        _resetCts?.Dispose();
        _resetCts = new CancellationTokenSource();
        var token = _resetCts.Token;
        _copied = true;

        try
        {
            await Task.Delay(2000, token);
            _copied = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _resetCts?.Cancel();
        _resetCts?.Dispose();
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
