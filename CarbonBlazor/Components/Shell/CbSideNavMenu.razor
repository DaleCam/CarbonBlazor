<li class="@ItemClassName" @attributes="AdditionalAttributes">
    <button type="button" class="cb-side-nav__submenu" aria-expanded="@AriaExpanded" @onclick="Toggle">
        @if (IconName.HasValue)
        {
            <CbIcon Name="@IconName.Value" SizeToken="CbIconSize.Size16" Class="cb-side-nav__icon" />
        }
        <span class="cb-side-nav__submenu-title">@Text</span>
        <CbIcon Name="CbIconName.ChevronDown" SizeToken="CbIconSize.Size16" Class="cb-side-nav__icon cb-side-nav__submenu-chevron" />
    </button>
    <ul class="cb-side-nav__menu" hidden="@(!Open)">
        @ChildContent
    </ul>
</li>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public CbIconName? IconName { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ItemClassName => new CssBuilder("cb-side-nav__item").Add(Class).ToString();
    private string AriaExpanded => Open ? "true" : "false";

    private async Task Toggle()
    {
        Open = !Open;
        await OpenChanged.InvokeAsync(Open);
    }
}
