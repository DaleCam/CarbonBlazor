<a class="@ClassName" href="@Href" @attributes="AdditionalAttributes">
    @if (ChildContent is null)
    {
        @Text
    }
    else
    {
        @ChildContent
    }
</a>

@code {
    [Parameter] public string Href { get; set; } = "#main-content";
    [Parameter] public string Text { get; set; } = "Skip to main content";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassName => new CssBuilder("cb-skip-to-content").Add(Class).ToString();
}
