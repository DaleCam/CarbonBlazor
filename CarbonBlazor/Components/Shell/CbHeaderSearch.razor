@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@ClassName" id="@RootId" @attributes="AdditionalAttributes">
    @if (!Active)
    {
        <button type="button" class="cb-header__search-trigger" aria-label="@OpenLabel" @onclick="Activate">
            <CbIcon Name="CbIconName.Search" SizeToken="CbIconSize.Size20" />
        </button>
    }
    else
    {
        <div class="cb-header__search-field" role="search" @onkeydown="OnKeyDown">
            <CbIcon Name="CbIconName.Search" SizeToken="CbIconSize.Size16" Class="cb-header__search-magnifier" />
            <label class="cb-sr-only" for="@InputId">@Label</label>
            <input id="@InputId"
                   class="cb-header__search-input"
                   type="text"
                   role="combobox"
                   aria-expanded="@HasResults"
                   aria-autocomplete="list"
                   autocomplete="off"
                   placeholder="@Placeholder"
                   value="@Value"
                   @oninput="OnInput" />
            <button type="button" class="cb-header__search-close" aria-label="@CloseLabel" @onclick="Deactivate">
                <CbIcon Name="CbIconName.Close" SizeToken="CbIconSize.Size20" />
            </button>
        </div>
        @if (ChildContent is not null)
        {
            <ul class="cb-header__search-menu" role="listbox" aria-label="@Label">
                <CascadingValue Value="this" IsFixed="true">
                    @ChildContent
                </CascadingValue>
            </ul>
        }
    }
</div>

@code {
    private readonly string _id = $"cb-header-search-{Guid.NewGuid():N}";
    private DotNetObjectReference<CbHeaderSearch>? _dotNetRef;
    private IJSObjectReference? _module;
    private bool _listeningForOutsideClick;
    private bool _focusInput;

    /// <summary>Placeholder text shown in the expanded search input.</summary>
    [Parameter] public string Placeholder { get; set; } = "Search";

    /// <summary>Accessible label for the search input.</summary>
    [Parameter] public string Label { get; set; } = "Search";

    /// <summary>Accessible label for the collapsed search trigger button.</summary>
    [Parameter] public string OpenLabel { get; set; } = "Search";

    /// <summary>Accessible label for the clear/close button.</summary>
    [Parameter] public string CloseLabel { get; set; } = "Close search";

    /// <summary>Current search text. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Whether the search is expanded. Use with <c>@bind-Active</c>.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }

    /// <summary>Custom result items, typically <see cref="CbHeaderSearchResult"/> components.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Collapse the search after a result is selected. Set <c>false</c> to keep it open and let the consumer decide.</summary>
    [Parameter] public bool CloseOnSelect { get; set; } = true;

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootId => _id;
    private string InputId => $"{_id}-input";
    private bool HasResults => ChildContent is not null;

    private string ClassName => new CssBuilder("cb-header__search")
        .Add("cb-header__search--active", Active)
        .Add(Class)
        .ToString();

    private async Task Activate()
    {
        if (Active)
        {
            return;
        }

        Active = true;
        _focusInput = true;
        await ActiveChanged.InvokeAsync(true);
    }

    private async Task Deactivate()
    {
        if (!Active)
        {
            return;
        }

        Active = false;
        _listeningForOutsideClick = false;

        if (!string.IsNullOrEmpty(Value))
        {
            Value = string.Empty;
            await ValueChanged.InvokeAsync(Value);
        }

        await ActiveChanged.InvokeAsync(false);
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await Deactivate();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/CarbonBlazor/carbon-blazor.js");

        if (_focusInput)
        {
            _focusInput = false;
            await _module.InvokeVoidAsync("focusById", InputId);
        }

        if (Active && !_listeningForOutsideClick)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("clickOutside", RootId, _dotNetRef, nameof(CloseFromOutside));
            _listeningForOutsideClick = true;
        }
    }

    internal async Task NotifyResultSelected()
    {
        if (CloseOnSelect)
        {
            await Deactivate();
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task CloseFromOutside()
    {
        await Deactivate();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeClickOutside", RootId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _dotNetRef?.Dispose();
    }
}
