<svg class="@ClassName"
     xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 32 32"
     width="@((int)SizeToken)"
     height="@((int)SizeToken)"
     aria-hidden="@(Label.IsNullOrWhiteSpace() ? "true" : null)"
     aria-label="@(Label.IsNullOrWhiteSpace() ? null : Label)"
     role="@(Label.IsNullOrWhiteSpace() ? null : "img")"
     fill="currentColor"
     @attributes="AdditionalAttributes">
    <use href="_content/CarbonBlazor/icons.svg#@SymbolId"></use>
</svg>

@code {
    [Parameter] public CbIconName Name { get; set; }
    [Parameter] public CbIconSize SizeToken { get; set; } = CbIconSize.Size16;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassName => new CssBuilder("cb-icon")
        .Add("cb-icon--sm", SizeToken == CbIconSize.Size16)
        .Add("cb-icon--md", SizeToken == CbIconSize.Size20)
        .Add("cb-icon--lg", SizeToken == CbIconSize.Size24)
        .Add("cb-icon--xl", SizeToken == CbIconSize.Size32)
        .Add(Class)
        .ToString();

    private string SymbolId => Name switch
    {
        CbIconName.Add => "add",
        CbIconName.BrightnessContrast => "brightness-contrast",
        CbIconName.Calendar => "calendar",
        CbIconName.CheckmarkFilled => "checkmark-filled",
        CbIconName.ChevronDown => "chevron-down",
        CbIconName.ChevronLeft => "chevron-left",
        CbIconName.ChevronRight => "chevron-right",
        CbIconName.ChevronUp => "chevron-up",
        CbIconName.Close => "close",
        CbIconName.Dashboard => "dashboard",
        CbIconName.DocumentBlank => "document-blank",
        CbIconName.Edit => "edit",
        CbIconName.ErrorFilled => "error-filled",
        CbIconName.Filter => "filter",
        CbIconName.Home => "home",
        CbIconName.Hospital => "hospital",
        CbIconName.Information => "information",
        CbIconName.Menu => "menu",
        CbIconName.Notification => "notification",
        CbIconName.OverflowMenuHorizontal => "overflow-menu-horizontal",
        CbIconName.OverflowMenuVertical => "overflow-menu-vertical",
        CbIconName.Pharmacy => "pharmacy",
        CbIconName.Report => "report",
        CbIconName.Search => "search",
        CbIconName.Settings => "settings",
        CbIconName.TrashCan => "trash-can",
        CbIconName.User => "user",
        CbIconName.Warning => "warning",
        _ => throw new System.ArgumentOutOfRangeException(nameof(Name), Name, "Unsupported icon name")
    };
}
