@implements IAsyncDisposable
@inject IJSRuntime Js

<span id="@RootId" class="@ClassName" @attributes="AdditionalAttributes">
    <button class="cb-popover__trigger" type="button" aria-expanded="@Open" aria-describedby="@PopoverId" @onclick="Toggle">@Trigger</button>
    @if (Open)
    {
        <span id="@PopoverId" class="cb-popover__content" role="dialog">@ChildContent</span>
    }
</span>

@code {
    private readonly string RootId = $"cb-popover-root-{Guid.NewGuid():N}";
    private readonly string PopoverId = $"cb-popover-{Guid.NewGuid():N}";
    private DotNetObjectReference<CbPopover>? _dotNetRef;
    private IJSObjectReference? _module;
    private bool _listeningForOutsideClick;

    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Caret { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private bool Open { get; set; }
    private string ClassName => new CssBuilder("cb-popover")
        .Add("cb-popover--caret", Caret)
        .Add(Class)
        .ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_listeningForOutsideClick)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/CarbonBlazor/carbon-blazor.js");
            await _module.InvokeVoidAsync("clickOutside", RootId, _dotNetRef, nameof(CloseFromOutside));
            _listeningForOutsideClick = true;
        }
    }

    private void Toggle()
    {
        Open = !Open;
        if (!Open)
        {
            _listeningForOutsideClick = false;
        }
    }

    [JSInvokable]
    public void CloseFromOutside()
    {
        Open = false;
        _listeningForOutsideClick = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
