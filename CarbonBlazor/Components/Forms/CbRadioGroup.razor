<fieldset class="@ClassName" disabled="@Disabled" aria-invalid="@Invalid" @attributes="AdditionalAttributes">
    <legend class="cb-label">@Legend</legend>
    <div class="cb-radio-group__items">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div class="cb-helper">@HelperText</div>
    }
    @if (Invalid && !string.IsNullOrWhiteSpace(InvalidText))
    {
        <div class="cb-requirement">@InvalidText</div>
    }
</fieldset>

@code {
    [Parameter] public string Legend { get; set; } = "Options";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? InvalidText { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public CbOrientation Orientation { get; set; } = CbOrientation.Vertical;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    internal string GroupName { get; } = $"cb-radio-{Guid.NewGuid():N}";
    private string ClassName => new CssBuilder("cb-radio-group")
        .Add("cb-radio-group--horizontal", Orientation == CbOrientation.Horizontal)
        .Add("cb-radio-group--invalid", Invalid)
        .Add(Class)
        .ToString();

    internal async Task SetValue(string? value)
    {
        if (Disabled || ReadOnly)
        {
            return;
        }

        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
