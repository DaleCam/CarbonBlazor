<div class="@ClassName" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public bool Condensed { get; set; }
    [Parameter] public bool Narrow { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassName => new CssBuilder("cb-layout-row")
        .Add("cb-layout-row--condensed", Condensed)
        .Add("cb-layout-row--narrow", Narrow)
        .Add(Class)
        .ToString();
}
